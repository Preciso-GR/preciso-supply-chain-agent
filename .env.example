# Keep secrets local. Do not commit a populated .env file.
ANTHROPIC_API_KEY=
SUPPLY_CENTER_CLAUDE_MODEL=claude-sonnet-5

# PRECISO remains the graph authority.
PRECISO_MCP_CWD=/absolute/path/to/preciso-graphrag
PRECISO_MCP_COMMAND=python3
PRECISO_MCP_ARGS=-m preciso_mcp.server
GRAPHRAG_MCP_WORKDIR=/absolute/path/to/preciso-supply-chain/data/preciso
GRAPHRAG_EMBEDDING_PROVIDER=fallback
